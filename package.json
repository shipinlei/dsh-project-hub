{
  "name": "dsh-project-hub",
  "version": "0.1.0",
  "description": "DSH 项目工作台：按工作区（项目）组织会话，项目内共享记忆与设定。Project workbench for DeepSeek Harness.",
  "license": "MIT",
  "author": "shipinlei",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "homepage": "https://github.com/shipinlei/dsh-project-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipinlei/dsh-project-hub.git"
  },
  "bugs": {
    "url": "https://github.com/shipinlei/dsh-project-hub/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "workspace",
    "project",
    "session",
    "memory",
    "web-ui"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/state.js && node --check lib/index.js && node --check client/client.js",
    "test": "node scripts/test-host.mjs && node scripts/test-client.mjs client/client.js && node scripts/test-client-interaction.mjs client/client.js",
    "test:host": "node scripts/test-host.mjs",
    "test:client": "node scripts/test-client.mjs client/client.js",
    "test:interaction": "node scripts/test-client-interaction.mjs client/client.js",
    "test:dom": "node scripts/test-client-dom.mjs client/client.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
